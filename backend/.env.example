PORT=4000
CLIENT_URL=http://localhost:5173
# Production (Vercel): https://doctor-tau-rouge.vercel.app
JWT_SECRET=change-this-to-a-long-random-string

# MongoDB Atlas (recommended). Create a free cluster at https://cloud.mongodb.com
# then paste the connection string below.
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/prescripto?retryWrites=true&w=majority
ALLOW_EMBEDDED_MONGO=true

# Razorpay Dashboard → Account & Settings → API Keys (use Test mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
# Optional: webhooks (production). Localhost needs ngrok.
RAZORPAY_WEBHOOK_SECRET=
# Set true only if you want Pay to skip Checkout when keys are missing
ALLOW_DEMO_PAY=false

# Optional: Groq (free) or OpenAI for smarter symptom matching. Without a key, a local guide still works.
GROQ_API_KEY=
OPENAI_API_KEY=
